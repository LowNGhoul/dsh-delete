{
  "name": "dsh-session-admin",
  "version": "0.2.0",
  "description": "Permanently delete DeepSeek Harness (dsh) conversations everywhere they are stored — append-only session logs, projection checkpoints, workspace membership, archive flags, pins, and scheduled tasks — with a GUI delete action and a /delete command.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./engine": "./lib/engine.js",
    "./errors": "./lib/errors.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-session-admin": "./lib/cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "SECURITY.md",
    "VERIFY.md",
    "install.sh",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "scripts": {
    "test": "node --test 'test/*.test.js'"
  },
  "license": "MIT",
  "keywords": [
    "dsh-delete",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "session",
    "conversation",
    "delete",
    "purge",
    "privacy"
  ],
  "author": "LowNGhoul",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LowNGhoul/dsh-delete.git"
  },
  "homepage": "https://github.com/LowNGhoul/dsh-delete#readme",
  "bugs": {
    "url": "https://github.com/LowNGhoul/dsh-delete/issues"
  }
}
